<?xml version="1.0"?>
<!-- Table-only cell: robot, its 1.00 x 0.50 m table and the OAK camera.
     No objects, no AprilTags. World name kept as fr3_workspace so the
     spawn and bridge launch files work unchanged. -->
<sdf version="1.9">
  <world name="fr3_workspace">
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <!-- Contact sensors (gripper jaw force pads). -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Raise indirect illumination without replacing the GLB materials.
         This keeps the original cardboard texture visible to the RGB camera. -->
    <scene>
      <ambient>0.60 0.60 0.60 1</ambient>
      <background>0.65 0.65 0.68 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- Soft fill light keeps embedded GLB textures readable by both the
         Gazebo camera and later YOLO training/inference. -->
    <light type="point" name="workcell_fill_light">
      <pose>0.90 0.55 2.50 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.35</constant>
        <linear>0.03</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
    </light>

    <include><uri>model://table</uri></include>
    <!-- Objects put on the real table on 2026-10-28, recognised by Gemini
         Robotics-ER and measured from the OAK image (table-corner frame). -->
    <include>
      <uri>model://measured_mouse</uri>
      <name>measured_mouse</name>
      <pose>0.671 0.664 1.0 0 0 -0.602</pose>
    </include>
    <include>
      <uri>model://screwdriver</uri>
      <name>screwdriver</name>
      <pose>0.864 0.568 1.0 0 0 -0.656</pose>
    </include>
    <!-- Simulation RGB-D camera: oblique view from the front of the table,
         rolled 90 degrees to use the image width for the table's long axis.
         This is a visibility setup, not the real camera's measured pose.
         Keep in sync with OAK_POSE in launch/camera_bridge.launch.py. -->
    <include>
      <uri>model://oak_d_pro_w</uri>
      <name>oak_d_pro_w</name>
      <pose>0.52 0.64 1.95 1.57079632679 1.10 0</pose>
    </include>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
