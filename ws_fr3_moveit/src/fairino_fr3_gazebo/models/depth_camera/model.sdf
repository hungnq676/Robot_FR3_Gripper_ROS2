<?xml version="1.0"?>
<sdf version="1.9">

  <model name="external_depth_camera">
    <static>true</static>

    <link name="camera_link">

      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.08 0.12 0.05</size>
          </box>
        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>


      <!-- DEPTH -->


      <!-- RGB -->


      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <topic>/external_camera</topic>

        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.10</near>
            <far>5.0</far>
          </clip>

          <depth_camera>
            <clip>
              <near>0.10</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>

    </link>

  </model>
</sdf>