<?xml version="1.0"?>
<sdf version="1.9">

  <model name="apriltag_0">
    <static>true</static>

    <link name="tag_link">

      <!-- tag36h11 id 0: 0.15 m plate, 1-cell white margin, black square 0.12 m -->
      <visual name="tag_visual">
        <geometry>
          <box>
            <size>0.15 0.15 0.001</size>
          </box>
        </geometry>

        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>

          <pbr>
            <metal>
              <albedo_map>model://apriltag_0/materials/textures/tag36_11_00000.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Va chạm đơn giản -->
      <collision name="tag_collision">
        <geometry>
          <box>
            <size>0.15 0.15 0.001</size>
          </box>
        </geometry>
      </collision>

    </link>
  </model>

</sdf>
