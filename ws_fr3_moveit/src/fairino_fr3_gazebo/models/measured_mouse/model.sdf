<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Black computer mouse measured on the real table: 141 x 71 mm footprint
       (camera estimate); height 40 mm assumed (stereo depth on black plastic is
       unreliable). Origin on the table under its centre, x along its length. -->
  <model name="measured_mouse">
    <link name="mouse_link">
      <pose>0 0 0.02 0 0 0</pose>
      <inertial>
        <mass>0.09</mass>
        <inertia><ixx>4.3e-5</ixx><iyy>1.6e-4</iyy><izz>1.9e-4</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="shell">
        <geometry><ellipsoid><radii>0.0705 0.0355 0.020</radii></ellipsoid></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.135 0.065 0.040</size></box></geometry>
        <surface><friction><ode><mu>0.4</mu><mu2>0.4</mu2></ode></friction></surface>
      </collision>
    </link>
  </model>
</sdf>
