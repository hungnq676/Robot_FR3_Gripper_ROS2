<?xml version="1.0"?>
<model>
  <name>Computer mouse (scanned)</name>
  <version>2.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Razer Taipan White from Google Scanned Objects (Gazebo Fuel,
    GoogleResearch/Razer_Taipan_White_Ambidextrous_Gaming_Mouse, CC BY 4.0,
    Copyright 2020 Google LLC). Cable removed and scaled to 85 %
    (about 55 x 112 x 34 mm) so the 68 mm gripper can take it across its width.
  </description>
</model>
