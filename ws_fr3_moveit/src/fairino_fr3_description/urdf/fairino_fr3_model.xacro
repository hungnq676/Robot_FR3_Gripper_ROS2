  <!-- hardware_type:=fairino (real_robot.launch.py): the 3D-printed gripper
       actually built, whose fingers reach much further than main-frame.stl.
       Its jaws are not driven by ros2_control, so its collision is one open-jaw
       envelope on base_link_gripper; the sim keeps the moving clamp boxes. -->
  <xacro:property name="real_gripper" value="${'$(arg hardware_type)' == 'fairino'}"/>
  <link name="base_link_gripper">

    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://fairino_fr3_description/meshes/visual/gripper/main-frame.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <xacro:unless value="${real_gripper}">
    <!-- Box envelope of main-frame.stl (see the clamp collisions below). -->
    <collision>
      <origin xyz="0.077 0.03075 0.01325" rpy="0 0 0"/>
      <geometry>
        <box size="0.154 0.0615 0.0265"/>
      </geometry>
    </collision>
    </xacro:unless>
    <xacro:if value="${real_gripper}">
    <!-- Real gripper (drawn with the meshes above), fingers fully open; the
         flange axis is at (0.077, 0.0375) here, the flange face at z=-0.075
         (adapter below), the whole gripper turned -90 deg on the flange,
         ESP32-CAM side = +y.
         2026-11-01: flange straight down, finger tips just touching the table
         -> tips 165 mm from the flange face (+-2: table 8.7 or 12 mm); clamp.stl
         ends 90 mm past this frame's origin, so the origin is 75 mm out.
         Envelope: mounting ring 0..28 mm from the flange; body (servo,
         ESP32-CAM, rails, jaw blocks) 28..101 mm, 164 mm across the open jaws
         (x), y -51..+34 mm about the axis; finger triangles 101..168 mm
         (fingers 60 mm long), x 44..82 mm each side of the axis (jaws 88 mm
         apart inside when open, 2.9 mm closed). The fingers are triangles
         narrowing to the tip: y -51..+23 mm up to 135 mm from the flange, then
         only y -20..+10 mm (tip ~5 mm off the axis) to 168 mm; one full-height
         box kept a tilted low grasp (black tray) 1 cm too high. -->
    <visual>
      <!-- FR3_TOOL_1.stl: the 63 mm tool flange disc, on the flange face. -->
      <origin xyz="0.077 0.0375 -0.069" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://fairino_fr3_description/meshes/visual/gripper/fr3_tool_flange.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.077 0.0375 -0.061" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.075 0.028"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.077 0.029 -0.0105" rpy="0 0 0"/>
      <geometry>
        <box size="0.164 0.085 0.073"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.014 0.0235 0.043" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.074 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.014 0.0325 0.0765" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.030 0.033"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.140 0.0235 0.043" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.074 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.140 0.0325 0.0765" rpy="0 0 0"/>
      <geometry>
        <box size="0.038 0.030 0.033"/>
      </geometry>
    </collision>
    </xacro:if>

  </link>


  <joint name="adapter" type="fixed">

    <!-- Real gripper: mounted turned -90 deg about the flange axis compared
         with the sim (photo 2026-11-01 at j5 = -180 deg: jaws horizontal,
         ESP32-CAM up); same flange-axis point (0.077, 0.0375) in both. Its frame
         sits 75 mm out from the flange (finger tips at 165 mm, table touch). -->
    <xacro:unless value="${real_gripper}">
    <origin
      xyz="-0.077 -0.0375 0.12"
      rpy="0 0 0"/>
    </xacro:unless>
    <xacro:if value="${real_gripper}">
    <origin
      xyz="-0.0375 0.077 0.175"
      rpy="0 0 -1.5708"/>
    </xacro:if>

    <parent
      link="wrist3_link"/>

    <child
      link="base_link_gripper"/>

  </joint>


  <link name="clamp_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>


    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://fairino_fr3_description/meshes/visual/gripper/clamp.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- Box instead of the concave clamp.stl: bullet-featherstone reports mesh
         contacts ~1 cm early and they jitter, which shoved low objects around. -->
    <xacro:unless value="${real_gripper}">
    <collision>
      <origin xyz="0.023 0.04 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.046 0.08 0.02"/>
      </geometry>
    </collision>
    </xacro:unless>

  </link>


  <joint name="joint_clamp_1" type="prismatic">

    <parent
      link="base_link_gripper"/>

    <child
      link="clamp_1"/>

    <origin
      xyz="0.022 0 0.01"
      rpy="1.5708 0 1.5708"/>

    <axis
      xyz="0 0 -1"/>

    <limit
      lower="-0.036"
      upper="0"
      effort="50"
      velocity="0.1"/>

  </joint>


  <link name="clamp_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>


    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 3.14159265359"/>

      <geometry>
        <mesh
          filename="package://fairino_fr3_description/meshes/visual/gripper/clamp.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- Box instead of the concave clamp.stl: bullet-featherstone reports mesh
         contacts ~1 cm early and they jitter, which shoved low objects around. -->
    <xacro:unless value="${real_gripper}">
    <collision>
      <origin xyz="-0.023 -0.04 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.046 0.08 0.02"/>
      </geometry>
    </collision>
    </xacro:unless>

  </link>

  <joint name="joint_clamp_2" type="prismatic">

    <parent
      link="base_link_gripper"/>

    <child
      link="clamp_2"/>

    <origin
      xyz="0.132 0.047 0.01"
      rpy="1.5708 3.14159265359 -1.5708"/>

    <axis
      xyz="0 0 1"/>

    <!-- One motor drives both jaws symmetrically (rack/linkage): clamp_2
         follows clamp_1 with the opposite sign. -->
    <mimic joint="joint_clamp_1" multiplier="-1" offset="0"/>

    <limit
      lower="0"
      upper="0.036"
      effort="50"
      velocity="0.1"/>

  </joint>
  <link name="grasp_frame"/>

  <joint name="grasp_frame_joint" type="fixed">
    <parent link="base_link_gripper"/>
    <child link="grasp_frame"/>
    <!--
      TCP at the geometric centre of the usable jaw volume.
      At q=0 the inner jaw faces are x=0.042 and x=0.112 m,
      their common centre plane is y~=0.0235 m, and the fingers span
      z=0.01..0.09 m in base_link_gripper coordinates.
    -->
    <xacro:unless value="${real_gripper}">
    <origin xyz="0.077 0.0235 0.05" rpy="0 0 0"/>
    </xacro:unless>
    <!-- Real gripper: on the flange axis, 30 mm in from the finger tips
         (135 mm from the flange face): only the outer 30 mm of the 60 mm
         fingers should take the object (user, 2026-11-01). -->
    <xacro:if value="${real_gripper}">
    <origin xyz="0.077 0.0375 0.060" rpy="0 0 0"/>
    </xacro:if>
  </joint>  
</robot>
