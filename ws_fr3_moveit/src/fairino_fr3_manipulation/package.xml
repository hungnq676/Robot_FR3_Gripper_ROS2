<?xml version="1.0"?>
<package format="3">
  <name>fairino_fr3_manipulation</name>
  <version>0.1.0</version>
  <description>MoveIt manipulation demos for the FAIRINO FR3 custom gripper.</description>
  <maintainer email="hung@todo.todo">hung</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_task_constructor_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>shape_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>fairino_fr3_msgs</depend>

  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>fairino_fr3_moveit_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_task_constructor_capabilities</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
