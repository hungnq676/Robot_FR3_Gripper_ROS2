<?xml version="1.0" encoding="UTF-8"?>
<robot name="fairino_fr3">
  <group name="arm">
    <chain base_link="base_link" tip_link="grasp_frame"/>
  </group>
  <group name="gripper">
    <joint name="joint_clamp_1"/>
    <joint name="joint_clamp_2"/>
  </group>

  <!-- Hand-set pose on the real FR3 (2026-10-28); also the sim start pose. -->
  <group_state name="home" group="arm">
    <joint name="j1" value="-1.2957"/>
    <joint name="j2" value="-1.5756"/>
    <joint name="j3" value="-1.1733"/>
    <joint name="j4" value="-1.6223"/>
    <joint name="j5" value="1.4359"/>
    <joint name="j6" value="-1.5669"/>
  </group_state>
  <!-- Arm upright over its base: keeps the OAK camera's view of the table
       clear. Perception should run from here before planning a pick.
       j1 = 1.7104 - pi: keeps the work area in the middle of j1's range so
       grasps and places stay in one arm configuration (no elbow/wrist flips). -->
  <group_state name="observe" group="arm">
    <joint name="j1" value="-1.4312"/>
    <joint name="j2" value="-1.5708"/>
    <joint name="j3" value="0.0"/>
    <joint name="j4" value="-1.5708"/>
    <joint name="j5" value="0.0"/>
    <joint name="j6" value="0.0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <!-- Stay 1 mm inside both mechanical limits so Gazebo floating-point
         drift cannot make the MTC start state marginally out of bounds. -->
    <joint name="joint_clamp_1" value="-0.001"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <!-- These inward motions leave about 10 mm between the jaw faces. -->
    <joint name="joint_clamp_1" value="-0.03"/>
  </group_state>

  <!-- Use the actual TCP as MoveIt's end-effector interaction frame. -->
  <end_effector name="custom_gripper" parent_link="grasp_frame" parent_group="arm" group="gripper"/>
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upperarm_link" reason="Never"/>
  <disable_collisions link1="base_link_gripper" link2="clamp_1" reason="Adjacent"/>
  <disable_collisions link1="base_link_gripper" link2="clamp_2" reason="Adjacent"/>
  <disable_collisions link1="base_link_gripper" link2="wrist1_link" reason="Never"/>
  <disable_collisions link1="base_link_gripper" link2="wrist2_link" reason="Never"/>
  <disable_collisions link1="base_link_gripper" link2="wrist3_link" reason="Adjacent"/>
  <disable_collisions link1="clamp_1" link2="wrist1_link" reason="Never"/>
  <disable_collisions link1="clamp_1" link2="wrist2_link" reason="Never"/>
  <disable_collisions link1="clamp_1" link2="wrist3_link" reason="Never"/>
  <disable_collisions link1="clamp_2" link2="wrist1_link" reason="Never"/>
  <disable_collisions link1="clamp_2" link2="wrist2_link" reason="Never"/>
  <disable_collisions link1="clamp_2" link2="wrist3_link" reason="Never"/>
  <disable_collisions link1="forearm_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist1_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upperarm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="wrist1_link" reason="Never"/>
  <disable_collisions link1="wrist1_link" link2="wrist2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist1_link" link2="wrist3_link" reason="Never"/>
  <disable_collisions link1="wrist2_link" link2="wrist3_link" reason="Adjacent"/>
</robot>
