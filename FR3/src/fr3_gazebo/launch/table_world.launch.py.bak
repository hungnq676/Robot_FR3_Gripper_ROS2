import os

from launch import LaunchDescription
from launch.actions import ExecuteProcess, SetEnvironmentVariable, TimerAction
from launch_ros.actions import Node
from launch.substitutions import Command
from ament_index_python.packages import get_package_share_directory


def generate_launch_description():
    pkg_fr3_gazebo = get_package_share_directory('fr3_gazebo')
    pkg_fairino = get_package_share_directory('fairino_description')
    pkg_gripper = get_package_share_directory('fr3_with_custom_gripper_description')


    world = os.path.join(pkg_fr3_gazebo, 'worlds', 'table.world')
    models = os.path.join(pkg_fr3_gazebo, 'models')
    robot_xacro = os.path.join(pkg_fr3_gazebo, 'config', 'fr3_gazebo.urdf.xacro')

    resource_paths = ':'.join([
        models,
        '/home/hung/FR3/install',
        '/home/hung/FR3/install/share',
        '/home/hung/FR3/src/frcobot_ros2',
        '/home/hung/FR3/src',
    ])

    robot_description = {
        'robot_description': Command(['xacro ', robot_xacro])
    }

    return LaunchDescription([
        SetEnvironmentVariable(
            name='GZ_SIM_RESOURCE_PATH',
            value=resource_paths
        ),

        ExecuteProcess(
            cmd=['gz', 'sim', '-v', '4','-r', world],
            output='screen'
        ),

        Node(
            package='robot_state_publisher',
            executable='robot_state_publisher',
            parameters=[robot_description],
            output='screen'
        ),

        # TimerAction(
        #     period=3.0,
        #     actions=[
        #         Node(
        #             package='ros_gz_sim',
        #             executable='create',
        #             arguments=[
        #                 '-world', 'fr3_table_world',
        #                 '-name', 'fr3_robot',
        #                 '-topic', '/robot_description',
        #                 '-x', '0.2',
        #                 '-y', '0.1',
        #                 '-z', '1.3',
        #             ],
        #             output='screen'
        #         )
        #     ]
        # ),

        # TimerAction(
        #     period=5.0,
        #     actions=[
        #         Node(
        #             package='controller_manager',
        #             executable='spawner',
        #             arguments=['joint_state_broadcaster'],
        #             output='screen'
        #         ),
        #         Node(
