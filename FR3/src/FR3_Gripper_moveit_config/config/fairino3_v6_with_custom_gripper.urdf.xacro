<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino3_v6_with_custom_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fairino3_v6_with_custom_gripper urdf file -->
    <xacro:include filename="$(find fr3_with_custom_gripper_description)/urdf/fairino3_v6_with_custom_gripper.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="fairino3_v6_with_custom_gripper.ros2_control.xacro" />


    <xacro:fairino3_v6_with_custom_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
